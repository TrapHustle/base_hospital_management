<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Format papier A4 de l'ordonnance-->
    <record id="paperformat_prescription" model="report.paperformat">
        <field name="name">Ordonnance A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <!--Patient prescription report -->
    <record id="action_report_patient_prescription" model="ir.actions.report">
        <field name="name">Patient Prescription</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_hospital_management.patient_prescription_report</field>
        <field name="report_file">base_hospital_management.patient_prescription_report</field>
        <field name="binding_model_id" ref="model_res_partner"/>
        <field name="paperformat_id" ref="base_hospital_management.paperformat_prescription"/>
        <field name="binding_type">report</field>
    </record>
    <!--    Patient prescription report template (ordonnance format CSF)-->
    <template id="patient_prescription_report">
        <t t-call="web.basic_layout">
            <div class="page" style="font-family: Arial, Helvetica, sans-serif; color: #1c1c1c; font-size: 12px;">

                <!-- ============ EN-TÊTE CSF (codé en dur) ============ -->
                <t t-call="base_hospital_management.csf_report_header"/>

                <!-- ============ TITRE ============ -->
                <div style="text-align: center; margin: 18px 0 14px 0;">
                    <span style="font-size: 22px; font-weight: bold; letter-spacing: 3px; color: #6E2C50;">ORDONNANCE MÉDICALE</span>
                </div>

                <!-- ============ INFOS PATIENT / PRESCRIPTEUR ============ -->
                <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 10px;">
                    <tr>
                        <td style="padding: 5px 4px; width: 65%;">
                            <b>Nom et prénoms :</b>
                            <span style="border-bottom: 1px dotted #555; padding: 0 8px; font-weight: bold;"><t t-esc="patient_name"/></span>
                        </td>
                        <td style="padding: 5px 4px;">
                            <b>Âge :</b>
                            <span style="border-bottom: 1px dotted #555; padding: 0 8px;"><t t-esc="patient_age"/><t t-if="patient_age != ''"> ans</t></span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 5px 4px;">
                            <b>Médecin prescripteur :</b>
                            <span style="border-bottom: 1px dotted #555; padding: 0 8px;"><t t-esc="doctor_name"/></span>
                        </td>
                        <td style="padding: 5px 4px;">
                            <b>Date :</b>
                            <span style="border-bottom: 1px dotted #555; padding: 0 8px;"><t t-esc="date"/></span>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="padding: 5px 4px;">
                            <b>N° de dossier :</b>
                            <span style="border-bottom: 1px dotted #555; padding: 0 8px; font-weight: bold; color: #6E2C50;"><t t-esc="patient_seq"/></span>
                        </td>
                    </tr>
                </table>

                <!-- ============ TABLEAU DES MÉDICAMENTS ============ -->
                <table style="width: 100%; border-collapse: collapse; font-size: 12px; border: 1px solid #1E5C4B;">
                    <thead>
                        <tr style="background-color: #1E5C4B; color: #ffffff;">
                            <th style="border: 1px solid #1E5C4B; padding: 7px 6px; width: 6%;">N°</th>
                            <th style="border: 1px solid #1E5C4B; padding: 7px 6px; text-align: left; width: 49%;">Médicament / Forme galénique / Dosage</th>
                            <th style="border: 1px solid #1E5C4B; padding: 7px 6px; width: 12%;">Nombre</th>
                            <th style="border: 1px solid #1E5C4B; padding: 7px 6px; text-align: left; width: 33%;">Posologie</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="datas" t-as="line">
                            <td style="border: 1px solid #b7d6d5; padding: 9px 6px; text-align: center; font-weight: bold; vertical-align: top;"><t t-esc="line_index + 1"/></td>
                            <td style="border: 1px solid #b7d6d5; padding: 9px 6px; vertical-align: top;">
                                <span style="font-weight: bold;"><t t-esc="line['medicine']"/></span>
                                <t t-if="line['forme'] or line['dosage']">
                                    <span style="color: #555;">
                                        <t t-if="line['forme']"> · <t t-esc="line['forme']"/></t><t t-if="line['dosage']"> · <t t-esc="line['dosage']"/></t>
                                    </span>
                                </t>
                            </td>
                            <td style="border: 1px solid #b7d6d5; padding: 9px 6px; text-align: center; vertical-align: top;"><t t-esc="int(line['quantity'])"/></td>
                            <td style="border: 1px solid #b7d6d5; padding: 9px 6px; vertical-align: top;">
                                <t t-if="line['posologie']"><t t-esc="line['posologie']"/></t>
                                <t t-else=""><t t-esc="line['time']"/><t t-if="line['note']"> · <t t-esc="line['note']"/></t></t>
                            </td>
                        </tr>
                        <!-- Lignes vides pour atteindre 5 lignes comme la fiche papier -->
                        <t t-set="nblignes" t-value="len(datas)"/>
                        <t t-foreach="range(0, 5 - nblignes if nblignes &lt; 5 else 0)" t-as="empty">
                            <tr>
                                <td style="border: 1px solid #b7d6d5; padding: 14px 6px; text-align: center; font-weight: bold;"><t t-esc="nblignes + empty + 1"/></td>
                                <td style="border: 1px solid #b7d6d5;">&#160;</td>
                                <td style="border: 1px solid #b7d6d5;">&#160;</td>
                                <td style="border: 1px solid #b7d6d5;">&#160;</td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- ============ VALIDITÉ + DIAGNOSTIC (cases de la fiche papier) ============ -->
                <div style="margin-top: 12px; font-size: 12px;">
                    <t t-if="diagnosis">
                        <div style="margin-bottom: 8px;"><b>Diagnostic :</b> <t t-esc="diagnosis"/></div>
                    </t>
                    <div style="font-weight: bold; margin-bottom: 6px;">Validité de l'ordonnance :</div>
                    <div style="line-height: 2.1;">
                        <t t-call="base_hospital_management.fiche_case">
                            <t t-set="case_on" t-value="validity_type != 'renouvelable'"/>
                        </t>
                        &#160; Ordonnance ponctuelle<br/>
                        <t t-call="base_hospital_management.fiche_case">
                            <t t-set="case_on" t-value="validity_type == 'renouvelable'"/>
                        </t>
                        &#160; Ordonnance renouvelable
                        <span style="display: inline-block; min-width: 46px; border-bottom: 1px solid #1c1c1c; text-align: center;"><t t-esc="renewable_months"/></span>
                        mois &#160;&#160;
                        <span style="display: inline-block; min-width: 46px; border-bottom: 1px solid #1c1c1c; text-align: center;"><t t-esc="renewable_times"/></span>
                        fois
                    </div>
                </div>

                <!-- ============ CACHET ET SIGNATURE ============ -->
                <table style="width: 100%; border-collapse: collapse; margin-top: 45px;">
                    <tr>
                        <td style="width: 55%;"/>
                        <td style="text-align: center; vertical-align: bottom;">
                            <div style="font-weight: bold; color: #6E2C50; font-size: 12px;">Cachet et signature du médecin</div>
                            <div style="margin: 8px auto 0 auto; width: 130px; height: 90px; border: 1px dashed #999;"/>
                        </td>
                    </tr>
                </table>

                <!-- ============ PIED DE PAGE CSF ============ -->
                <t t-call="base_hospital_management.csf_report_footer"/>
                <div style="text-align: center; color: #adb5bd; font-size: 8px; margin-top: 4px;">Réf. <t t-esc="op_reference"/></div>
            </div>
        </t>
    </template>
         <!--Report paper format-->
    <record id="paperformat_patient" model="report.paperformat">
        <field name="name">Custom Paper</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">55</field>
        <field name="page_width">30</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">1.00</field>
        <field name="margin_bottom">1.00</field>
        <field name="margin_left">0.00</field>
        <field name="margin_right">1.00</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">125</field>
    </record>
    <!--        Patient card report action-->
    <record id="action_report_patient_card" model="ir.actions.report">
        <field name="name">Patient Card</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_hospital_management.patient_card_report</field>
        <field name="report_file">base_hospital_management.patient_card_report</field>
        <field name="binding_model_id" ref="model_res_partner"/>
        <field name="paperformat_id"
               ref="base_hospital_management.paperformat_patient"/>
        <field name="binding_type">report</field>
    </record>
    <!--    Patient card template-->
    <template id="patient_card_report">
        <t t-call="web.html_container">
            <section>
                <div style="width: 500px; height: 260px; border: 2px black solid;
            border-radius: 5px;">
                    <div class="container"
                         style="width: 500px; height: 50px; background-color:red">
                        <span>
                            <i class="fa fa-wave-pulse" style="color:black;"/>
                        </span>
                        <h1 style="margin-left: 150px; padding-top: 10px; color:white; border-radius: 10px;">
                            Patient Card
                        </h1>
                        <div class="page">
                            <h1 style="margin-left: 15px;">
                                <t t-esc="name"/>
                                <br/>
                                <label style="font-size: 18px;">
                                    <b>Code :
                                        <t t-esc="code"/>
                                    </b>
                                </label>
                            </h1>
                            <p style="margin-left: 15px;">
                                <label>
                                    <b>Gender :</b>
                                    <t t-esc="gender"/>
                                </label>
                                <br/>
                                <label>
                                    <b>Age :</b>
                                    <t t-esc="age"/>
                                </label>
                                <br/>
                                <label>
                                    <b>DOB :</b>
                                    <t t-esc="dob"/>
                                </label>
                                <br/>
                                <label>
                                    <b>Blood Group :</b>
                                    <t t-esc="blood"/>
                                    <br/>
                                </label>
                                <label>
                                    <b>Phone :</b>
                                    <t t-esc="phone"/>
                                </label>
                                <br/>
                                <label style="position:absolute; left:350px; top:100px;">
                                    <img t-attf-src="data:image/png;base64,{{image['image_1920']}}"
                                         style="max-height: 130px; max-width: 130px;"/>
                                </label>
                                <br/>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
            <section>
                <div class="container"
                     style="margin-top:50px">
                    <div style="width: 500px; height: 250px; border: 2px black
                    solid; border-radius: 5px;">
                        <div style="margin-left: 10px; margin-top: 10px;">
                            <span style="padding-top:5px padding-top:5px">
                                <b>Address:</b>
                                <br/>
                                <t t-esc="street"/>
                                <br/>
                                <t t-esc="street2"/>
                                <br/>
                                <t t-esc='city'/>
                                <t t-esc='state'/>
                                <br/>
                                <t t-esc='country'/>
                                <br/>
                                <br/>
                            </span>
                            <span style="padding-top:5px padding-top:5px">
                                <b>
                                    <t t-esc="company_name"/>
                                </b>
                                <br/>
                                <t t-esc="company_street"/>
                                <br/>
                                <t t-esc="company_street2"/>
                                <br/>
                                <t t-esc='company_city'/>
                                <t t-esc='company_state'/>
                                <br/>
                                <t t-esc='company_zip'/>
                                <br/>
                                <br/>
                            </span>
                        </div>
                        <div>
                            <img style="max-height: 150px; max-width: 180px;
                            position:absolute; left:310px; top:290px;"
                                 t-attf-src="data:image/gif;base64,
                                 {{barcode['barcode_png']}}"/>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>
