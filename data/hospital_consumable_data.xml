<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ================================================================ -->
    <!--  CONSOMMABLES (stock) - CSF Medical Center                       -->
    <!--  Produits stockables (Goods + suivi de stock).                   -->
    <!--  Les quantités proviennent de l'inventaire du 05/03/2026         -->
    <!--  (colonne "Quantité restant"). Elles sont chargées UNE SEULE     -->
    <!--  FOIS par _csf_load_consumable_stock (voir models/               -->
    <!--  product_template.py) sous forme d'ajustement d'inventaire :     -->
    <!--  un upgrade ultérieur ne remet donc pas les stocks à zéro.       -->
    <!-- ================================================================ -->
    <data noupdate="1">
        <record id="prod_tube_violet" model="product.template">
            <field name="name">Tube violet</field>
            <field name="categ_id" ref="categ_consommables"/>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="sale_ok" eval="False"/>
            <!-- Quantité restante inventaire : 130 -->
        </record>
