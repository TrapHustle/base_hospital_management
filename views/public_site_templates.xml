<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         LIENS DU PORTAIL DANS LA BARRE DU SITE (a cote du logo)
         Visibles uniquement pour un patient connecte.
         ============================================================ -->
    <template id="portal_nav_links" inherit_id="website.navbar_nav"
              name="Liens portail patient">
        <xpath expr="//t[@t-out='0']" position="after">
            <t t-if="not request.env.user._is_public() and request.env.user.has_group('base.group_portal')">
                <t t-set="_p" t-value="request.httprequest.path"/>
                <li class="nav-item">
                    <a t-attf-class="nav-link#{' active' if _p == '/my/health' else ''}" href="/my/health">Espace santé</a>
                </li>
                <li class="nav-item">
                    <a t-attf-class="nav-link#{' active' if '/my/vaccinations' in _p else ''}" href="/my/vaccinations">Vaccinations</a>
                </li>
                <li class="nav-item">
                    <a t-attf-class="nav-link#{' active' if '/my/tests' in _p else ''}" href="/my/tests">Analyses</a>
                </li>
                <li class="nav-item">
                    <a t-attf-class="nav-link#{' active' if '/my/op' in _p else ''}" href="/my/op">Consultations</a>
                </li>
                <li class="nav-item">
                    <a t-attf-class="nav-link#{' active' if '/my/appointments' in _p else ''}" href="/my/appointments">Rendez-vous</a>
                </li>
                <li class="nav-item">
                    <a t-attf-class="nav-link#{' active' if '/my/prescriptions' in _p else ''}" href="/my/prescriptions">Ordonnances</a>
                </li>
            </t>
        </xpath>
    </template>

    <!-- ============================================================
         PAGE D'ACCUEIL PUBLIQUE  /accueil
         ============================================================ -->
    <template id="public_landing" name="Accueil — SIH">
        <t t-call="website.layout">
            <div class="o_hms_portal hms-landing">

                <!-- HERO -->
                <section class="hms-lhero">
                    <div class="hms-lhero-text">
                        <span class="hms-lbadge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/></svg>
                            Système d'Information Hospitalier
                        </span>
                        <h1>Votre hôpital,<br/>désormais en ligne.</h1>
                        <p class="hms-lsub">
                            Dossier patient unique, prise de rendez-vous, téléconsultation,
                            résultats d'analyses et ordonnances — tout votre parcours de soins
                            centralisé et sécurisé, accessible depuis votre téléphone.
                        </p>
                        <div class="hms-lbtns">
                            <t t-if="request.env.user._is_public()">
                                <a href="/patient/signup" class="hms-btn big">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M22 11h-6"/></svg>
                                    Créer mon compte
                                </a>
                                <a href="/web/login" class="hms-btn ghost big">Se connecter</a>
                            </t>
                            <t t-else="">
                                <a href="/my/health" class="hms-btn big">Mon espace santé</a>
                            </t>
                        </div>
                    </div>

                    <!-- Illustration : telephone montrant le portail -->
                    <div class="hms-lhero-art">
                        <div class="hms-phone">
                            <div class="hms-phone-notch"></div>
                            <div class="hms-phone-screen">
                                <div class="hms-phone-hero">
                                    <div class="hms-phone-cross">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" d="M12 6v12M6 12h12"/></svg>
                                    </div>
                                    <div>
                                        <div class="hms-phone-hi">Bonjour 👋</div>
                                        <div class="hms-phone-sub">Espace santé</div>
                                    </div>
                                </div>
                                <div class="hms-phone-grid">
                                    <div class="hms-phone-tile g"><span>2</span>Vaccins</div>
                                    <div class="hms-phone-tile b"><span>3</span>Analyses</div>
                                    <div class="hms-phone-tile a"><span>4</span>Consult.</div>
                                    <div class="hms-phone-tile p"><span>1</span>RDV</div>
                                </div>
                                <div class="hms-phone-row">
                                    <span class="hms-phone-dot"></span> Ordonnance du 12/06 prête
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- FONCTIONNALITES -->
                <section class="hms-lsection">
                    <h2 class="hms-ltitle">Tout votre suivi médical, au même endroit</h2>
                    <p class="hms-lintro">Une plateforme unique pour les patients et les équipes soignantes.</p>
                    <div class="hms-features">
                        <div class="hms-feature">
                            <div class="hms-ic r"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path stroke-linecap="round" d="M9 12h6M9 16h4"/></svg></div>
                            <h3>Dossier patient unique</h3>
                            <p>Un identifiant, un historique complet : consultations, traitements et examens réunis.</p>
                        </div>
                        <div class="hms-feature">
                            <div class="hms-ic c"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="4" width="18" height="17" rx="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 9h18M8 2v4M16 2v4m-7 9 2 2 4-4"/></svg></div>
                            <h3>Rendez-vous en ligne</h3>
                            <p>Réservez une consultation avec le médecin de votre choix, en quelques secondes.</p>
                        </div>
                        <div class="hms-feature">
                            <div class="hms-ic v"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="6" width="13" height="12" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="m15 10 5-3v10l-5-3"/></svg></div>
                            <h3>Téléconsultation</h3>
                            <p>Consultez votre médecin à distance, en vidéo, directement depuis votre rendez-vous.</p>
                        </div>
                        <div class="hms-feature">
                            <div class="hms-ic l"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6M10 3v7L5 19a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3"/></svg></div>
                            <h3>Résultats &amp; ordonnances</h3>
                            <p>Retrouvez vos analyses et vos ordonnances en ligne, à tout moment.</p>
                        </div>
                        <div class="hms-feature">
                            <div class="hms-ic v"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m18 2 4 4M17 7 7 17m-2 0-3 3m13.5-9.5L20 8m-9 9-1 4 4-1"/></svg></div>
                            <h3>Suivi vaccinal</h3>
                            <p>Votre carnet de vaccination numérique, avec certificats téléchargeables.</p>
                        </div>
                        <div class="hms-feature">
                            <div class="hms-ic p"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/></svg></div>
                            <h3>Sécurité des données</h3>
                            <p>Vos données de santé sont isolées : vous seul accédez à votre dossier.</p>
                        </div>
                    </div>
                </section>

                <!-- COMMENT CA MARCHE -->
                <section class="hms-lsection">
                    <h2 class="hms-ltitle">Comment ça marche</h2>
                    <div class="hms-steps">
                        <div class="hms-step">
                            <div class="hms-step-num">1</div>
                            <h3>Créez votre compte</h3>
                            <p>En une minute, avec votre nom et votre e-mail.</p>
                        </div>
                        <div class="hms-step">
                            <div class="hms-step-num">2</div>
                            <h3>Prenez rendez-vous</h3>
                            <p>Choisissez votre médecin et votre créneau en ligne.</p>
                        </div>
                        <div class="hms-step">
                            <div class="hms-step-num">3</div>
                            <h3>Suivez vos soins</h3>
                            <p>Résultats, ordonnances et téléconsultations à portée de main.</p>
                        </div>
                    </div>
                </section>

                <!-- CTA FINAL -->
                <section class="hms-cta" t-if="request.env.user._is_public()">
                    <h2>Prêt à commencer ?</h2>
                    <p>Créez votre espace santé gratuitement dès maintenant.</p>
                    <a href="/patient/signup" class="hms-btn ghost big">Créer mon compte</a>
                </section>

            </div>
        </t>
    </template>

    <!-- ============================================================
         FORMULAIRE D'INSCRIPTION  /patient/signup
         ============================================================ -->
    <template id="public_signup" name="Créer un compte patient">
        <t t-call="website.layout">
            <div class="o_hms_portal hms-authwrap">
                <div class="hms-authcard">
                    <div class="hms-auth-head">
                        <div class="hms-auth-cross">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" d="M12 6v12M6 12h12"/></svg>
                        </div>
                        <h1>Créer mon compte</h1>
                        <p>Accédez à votre espace santé en quelques secondes.</p>
                    </div>

                    <div t-if="error" class="hms-err">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 8v5m0 3h.01"/></svg>
                        <span t-esc="error"/>
                    </div>

                    <form action="/patient/signup/submit" method="post" class="hms-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="hms-field">
                            <label>Nom complet</label>
                            <input type="text" name="name" required="required"
                                   t-att-value="values.get('name') or ''"
                                   placeholder="Ex. Kouamé Serge N'Guessan"/>
                        </div>
                        <div class="hms-field">
                            <label>Adresse e-mail</label>
                            <input type="email" name="email" required="required"
                                   t-att-value="values.get('email') or ''"
                                   placeholder="vous@exemple.com"/>
                        </div>
                        <div class="hms-field-row">
                            <div class="hms-field">
                                <label>Téléphone</label>
                                <input type="text" name="phone"
                                       t-att-value="values.get('phone') or ''"
                                       placeholder="+225 ..."/>
                            </div>
                            <div class="hms-field">
                                <label>Date de naissance</label>
                                <input type="date" name="date_of_birth"
                                       t-att-value="values.get('date_of_birth') or ''"/>
                            </div>
                        </div>
                        <div class="hms-field">
                            <label>Mot de passe</label>
                            <input type="password" name="password" required="required"
                                   minlength="6" placeholder="6 caractères minimum"/>
                        </div>
                        <button type="submit" class="hms-btn big" style="width:100%;justify-content:center">
                            Créer mon compte
                        </button>
                    </form>

                    <p class="hms-auth-foot">
                        Vous avez déjà un compte ?
                        <a href="/web/login">Se connecter</a>
                    </p>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================
         CORPS DE L'E-MAIL DE BIENVENUE
         ============================================================ -->
    <template id="welcome_email_body" name="E-mail de bienvenue patient">
        <div style="font-family:Arial,sans-serif;max-width:520px;margin:auto;color:#1f2430">
            <div style="background:linear-gradient(135deg,#714B67,#8e5d80);border-radius:16px;padding:28px;text-align:center;color:#fff">
                <div style="font-size:34px;line-height:1">✚</div>
                <h1 style="margin:8px 0 0;font-size:22px;color:#fff">Bienvenue<t t-if="company"> à <t t-esc="company.name"/></t> !</h1>
            </div>
            <div style="padding:24px 8px">
                <p>Bonjour <strong t-esc="partner.name"/>,</p>
                <p>Votre espace santé a bien été créé. Vous pouvez dès à présent prendre
                   rendez-vous, consulter vos résultats et vos ordonnances, et échanger
                   avec votre médecin en téléconsultation.</p>
                <p style="background:#f6f0f4;border-radius:12px;padding:14px 16px">
                    <strong>Votre numéro de dossier patient :</strong>
                    <span t-esc="patient_seq" style="color:#714B67;font-weight:700"/>
                </p>
                <p>À très bientôt,<br/>
                   <t t-if="company"><t t-esc="company.name"/></t></p>
            </div>
        </div>
    </template>

</odoo>
