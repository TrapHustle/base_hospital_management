<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    Product category action (native product.category)-->
    <record id="product_category_action" model="ir.actions.act_window">
        <field name="name">Catégories de produits</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle catégorie de produit
            </p>
            <p>
                Organisez vos actes et produits par catégorie
                (Consultations, Soins, Imagerie, Biologie, etc.).
            </p>
        </field>
    </record>
    <!--    Product category menu-->
    <menuitem id="product_category_menu" name="Catégories de produits"
              sequence="5" parent="hospital_menu_configuration"
              action="product_category_action"/>
</odoo>
