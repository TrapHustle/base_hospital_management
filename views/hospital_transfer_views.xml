<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    Transfer bulletin tree view-->
    <record id="hospital_transfer_view_tree" model="ir.ui.view">
        <field name="name">hospital.transfer.view.tree</field>
        <field name="model">hospital.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="transfer_date"/>
                <field name="patient_id"/>
                <field name="motif_transfert"/>
                <field name="structure_accueil"/>
                <field name="doctor_id"/>
            </list>
        </field>
    </record>
    <!--    Transfer bulletin form view-->
    <record id="hospital_transfer_view_form" model="ir.ui.view">
        <field name="name">hospital.transfer.view.form</field>
        <field name="model">hospital.transfer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="patient_age"/>
                            <field name="op_id"/>
                        </group>
                        <group>
                            <field name="transfer_date"/>
                            <field name="doctor_id"/>
                            <field name="venu_pour"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Admission">
                            <group>
                                <group>
                                    <field name="admission_datetime"/>
                                    <field name="motif_transfert"/>
                                </group>
                                <group string="Constantes à l'admission">
                                    <field name="etat_general_in"/>
                                    <field name="temperature_in"/>
                                    <field name="ta_in"/>
                                    <field name="fc_in"/>
                                    <field name="fr_in"/>
                                    <field name="spo2_in"/>
                                </group>
                            </group>
                            <separator string="Résumé anamnèse"/>
                            <field name="anamnese"
                                   placeholder="Résumé de l'anamnèse…"/>
                            <separator string="Résumé examen clinique à l'admission"/>
                            <field name="examen_admission"
                                   placeholder="Examen clinique à l'admission…"/>
                        </page>
                        <page string="Prise en charge">
                            <separator string="Diagnostic retenu"/>
                            <field name="diagnostic"
                                   placeholder="Diagnostic retenu…"/>
                            <separator string="Examen réalisé"/>
                            <field name="examen_realise"
                                   placeholder="Examens réalisés au centre…"/>
                            <separator string="Traitement administré"/>
                            <field name="traitement"
                                   placeholder="Traitement administré…"/>
                        </page>
                        <page string="Sortie et transfert">
                            <group>
                                <group>
                                    <field name="exit_datetime"/>
                                    <field name="structure_accueil"/>
                                </group>
                                <group string="Constantes à la sortie">
                                    <field name="etat_general_out"/>
                                    <field name="temperature_out"/>
                                    <field name="ta_out"/>
                                    <field name="fc_out"/>
                                    <field name="fr_out"/>
                                    <field name="spo2_out"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!--    Transfer bulletin search view-->
    <record id="hospital_transfer_view_search" model="ir.ui.view">
        <field name="name">hospital.transfer.view.search</field>
        <field name="model">hospital.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="patient_id"/>
                <field name="structure_accueil"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_patient" string="Patient"
                            context="{'group_by': 'patient_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'transfer_date'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--    Transfer bulletin action-->
    <record id="hospital_transfer_action" model="ir.actions.act_window">
        <field name="name">Bulletins de transfert</field>
        <field name="res_model">hospital.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Établir un bulletin de transfert
            </p>
            <p>
                Constantes à l'admission et à la sortie, diagnostic retenu,
                traitement administré et structure sanitaire d'accueil.
            </p>
        </field>
    </record>
    <!--    Transfer bulletin menu-->
    <menuitem id="hospital_transfer_menu" name="Bulletins de transfert"
              sequence="2" parent="hospital_menu_fiches"
              action="hospital_transfer_action"/>
</odoo>
